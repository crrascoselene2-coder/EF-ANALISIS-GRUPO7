// Multiplica los bloques bufIzq[nivel] (filasA x colsA) y bufDer[nivel] (colsA x colsB)
// almacenando el resultado en bufRes[nivel]
SubProceso MultiplicarMatricesNivel(bufIzq, filasA, colsA, bufDer, colsB, bufRes, nivel)
	Definir i, k, j Como Entero;
	Definir valorA Como Real;

	Para i <- 1 Hasta filasA Con Paso 1 Hacer
		Para j <- 1 Hasta colsB Con Paso 1 Hacer
			bufRes[nivel, i, j] <- 0;
		FinPara
	FinPara

	Para i <- 1 Hasta filasA Con Paso 1 Hacer
		Para k <- 1 Hasta colsA Con Paso 1 Hacer
			valorA <- bufIzq[nivel, i, k];
			Si valorA <> 0 Entonces
				Para j <- 1 Hasta colsB Con Paso 1 Hacer
					bufRes[nivel, i, j] <- bufRes[nivel, i, j] + valorA * bufDer[nivel, k, j];
				FinPara
			FinSi
		FinPara
	FinPara
FinSubProceso

// Evalua recursivamente TODAS las parentizaciones posibles entre i y j
SubProceso FuerzaBrutaCadena(dims, i, j, minOps Por Referencia, mejorOrden Por Referencia, mejorK, llamadas Por Referencia)
	Definir k, kOptimo Como Entero;
	Definir opsIzq, opsDer, opsUnion, opsTotal Como Real;
	Definir ordenIzq, ordenDer, ordenTemp Como Cadena;

	llamadas <- llamadas + 1;

	// Caso base: una sola matriz (0 multiplicaciones escalares)
	Si i = j Entonces
		minOps <- 0;
		mejorOrden <- Concatenar("A", ConvertirATexto(i));
	SiNo
		minOps <- -1;
		kOptimo <- i;
		mejorOrden <- "";

		// Probar cada posible punto de corte k entre i y j - 1
		Para k <- i Hasta j - 1 Con Paso 1 Hacer
			FuerzaBrutaCadena(dims, i, k, opsIzq, ordenIzq, mejorK, llamadas);
			FuerzaBrutaCadena(dims, k + 1, j, opsDer, ordenDer, mejorK, llamadas);

			// Costo de multiplicar la subcadena izquierda (A_i..A_k) por la derecha (A_{k+1}..A_j)
			opsUnion <- dims[i] * dims[k + 1] * dims[j + 1];
			opsTotal <- opsIzq + opsDer + opsUnion;

			Si minOps = -1 O opsTotal < minOps Entonces
				minOps <- opsTotal;
				kOptimo <- k;
				ordenTemp <- Concatenar("(", ordenIzq);
				ordenTemp <- Concatenar(ordenTemp, " x ");
				ordenTemp <- Concatenar(ordenTemp, ordenDer);
				mejorOrden <- Concatenar(ordenTemp, ")");
			FinSi
		FinPara

		mejorK[i, j] <- kOptimo;
	FinSi
FinSubProceso

// Multiplica las matrices reales siguiendo los cortes optimos mejorK[i,j]
SubProceso MultiplicarEnOrden(mats, filasM, colsM, mejorK, i, j, nivel, bufIzq, bufDer, bufRes, resF Por Referencia, resC Por Referencia)
	Definir f, c, k, fIzq, cIzq, fDer, cDer Como Entero;

	Si i = j Entonces
		resF <- filasM[i];
		resC <- colsM[i];
		Para f <- 1 Hasta resF Con Paso 1 Hacer
			Para c <- 1 Hasta resC Con Paso 1 Hacer
				bufRes[nivel, f, c] <- mats[i, f, c];
			FinPara
		FinPara
	SiNo
		k <- mejorK[i, j];

		// Resolver rama izquierda en nivel + 1 y copiar a bufIzq[nivel]
		MultiplicarEnOrden(mats, filasM, colsM, mejorK, i, k, nivel + 1, bufIzq, bufDer, bufRes, fIzq, cIzq);
		Para f <- 1 Hasta fIzq Con Paso 1 Hacer
			Para c <- 1 Hasta cIzq Con Paso 1 Hacer
				bufIzq[nivel, f, c] <- bufRes[nivel + 1, f, c];
			FinPara
		FinPara

		// Resolver rama derecha en nivel + 1 y copiar a bufDer[nivel]
		MultiplicarEnOrden(mats, filasM, colsM, mejorK, k + 1, j, nivel + 1, bufIzq, bufDer, bufRes, fDer, cDer);
		Para f <- 1 Hasta fDer Con Paso 1 Hacer
			Para c <- 1 Hasta cDer Con Paso 1 Hacer
				bufDer[nivel, f, c] <- bufRes[nivel + 1, f, c];
			FinPara
		FinPara

		// Multiplicar ambas subcadenas en el nivel actual
		MultiplicarMatricesNivel(bufIzq, fIzq, cIzq, bufDer, cDer, bufRes, nivel);
		resF <- fIzq;
		resC <- cDer;
	FinSi
FinSubProceso

Proceso MultiplicacionMatricesFuerzaBruta
	Definir n, idx, f, c, resF, resC, llamadas Como Entero;
	Definir minOps Como Real;
	Definir mejorOrden Como Cadena;
	Definir compatible Como Logico;

	Dimension mats[20, 20, 20];
	Dimension filasM[20];
	Dimension colsM[20];
	Dimension dims[21];
	Dimension mejorK[20, 20];
	Dimension bufIzq[25, 20, 20];
	Dimension bufDer[25, 20, 20];
	Dimension bufRes[25, 20, 20];

	Escribir "=== Multiplicacion de matrices mediante FUERZA BRUTA ===";
	Repetir
		Escribir "Cuantas matrices desea multiplicar? (2 a 15): ";
		Leer n;
		Si n < 2 O n > 15 Entonces
			Escribir "Debe ingresar un numero entre 2 y 15.";
		FinSi
	Hasta Que n >= 2 Y n <= 15;

	// Lectura de dimensiones y elementos de cada matriz
	Para idx <- 1 Hasta n Con Paso 1 Hacer
		Escribir "";
		Escribir "Matriz A", idx, ":";
		Repetir
			Escribir "  Filas de A", idx, " (1 a 20): ";
			Leer filasM[idx];
			Escribir "  Columnas de A", idx, " (1 a 20): ";
			Leer colsM[idx];
			Si filasM[idx] <= 0 O colsM[idx] <= 0 O filasM[idx] > 20 O colsM[idx] > 20 Entonces
				Escribir "  Dimensiones invalidas (deben estar entre 1 y 20).";
			FinSi
		Hasta Que filasM[idx] > 0 Y colsM[idx] > 0 Y filasM[idx] <= 20 Y colsM[idx] <= 20;

		Escribir "  Ingrese los elementos de A", idx, ":";
		Para f <- 1 Hasta filasM[idx] Con Paso 1 Hacer
			Para c <- 1 Hasta colsM[idx] Con Paso 1 Hacer
				Escribir Sin Saltar "    A", idx, "[", f, ",", c, "]: ";
				Leer mats[idx, f, c];
			FinPara
		FinPara
	FinPara

	// Verificacion de compatibilidad dimensional
	compatible <- Verdadero;
	Para idx <- 1 Hasta n - 1 Con Paso 1 Hacer
		Si colsM[idx] <> filasM[idx + 1] Entonces
			Escribir "";
			Escribir "Error: A", idx, " tiene ", colsM[idx], " columnas pero A", idx + 1, " tiene ", filasM[idx + 1], " filas.";
			compatible <- Falso;
		FinSi
	FinPara

	Si compatible Entonces
		// Vector de dimensiones: dims[1] = filas(A1), dims[idx+1] = columnas(A_idx)
		dims[1] <- filasM[1];
		Para idx <- 1 Hasta n Con Paso 1 Hacer
			dims[idx + 1] <- colsM[idx];
		FinPara

		llamadas <- 0;
		FuerzaBrutaCadena(dims, 1, n, minOps, mejorOrden, mejorK, llamadas);

		Escribir "";
		Escribir "Minimo de multiplicaciones escalares: ", minOps;
		Escribir "Mejor orden de parentizacion: ", mejorOrden;
		Escribir "Llamadas recursivas realizadas (Fuerza Bruta): ", llamadas;

		MultiplicarEnOrden(mats, filasM, colsM, mejorK, 1, n, 1, bufIzq, bufDer, bufRes, resF, resC);

		Escribir "";
		Escribir "Matriz Resultado (", resF, " x ", resC, "):";
		Para f <- 1 Hasta resF Con Paso 1 Hacer
			Para c <- 1 Hasta resC Con Paso 1 Hacer
				Escribir Sin Saltar bufRes[1, f, c], "  ";
			FinPara
			Escribir "";
		FinPara
	FinSi
FinProceso
