SubProceso MultiplicarMatrices(A Por Referencia, fA, cA, B Por Referencia, cB, C Por Referencia)
    Definir i, j, k Como Entero
    Definir valorA Como Real

    // Inicializar matriz C en 0
    Para i <- 1 Hasta fA Hacer
        Para j <- 1 Hasta cB Hacer
            C[i, j] <- 0
        FinPara
    FinPara

    // Orden i -> k -> j saltando ceros (equivalente al "continue" de Python)
    Para i <- 1 Hasta fA Hacer
        Para k <- 1 Hasta cA Hacer
            valorA <- A[i, k]
            Si valorA <> 0 Entonces
                Para j <- 1 Hasta cB Hacer
                    C[i, j] <- C[i, j] + valorA * B[k, j]
                FinPara
            FinSi
        FinPara
    FinPara
FinSubProceso

SubProceso minOp <- FuerzaBrutaCadena(p Por Referencia, i, j, s Por Referencia, mejorOrden Por Referencia)
    Definir k, mejorK, minOp, opIzq, opDer, opUnion, opTotal Como Entero
    Definir ordIzq, ordDer Como Texto

    Si i = j Entonces
        minOp <- 0
        s[i, j] <- 0
        mejorOrden <- "A" + ConvertirATexto(i)
    SiNo
        minOp <- -1
        mejorK <- i
        mejorOrden <- ""
        ordIzq <- ""
        ordDer <- ""

        // Fuerza bruta: prueba recursivamente todos los cortes k sin tabla DP
        // En base 1, Ai tiene tamaño p[i] x p[i + 1]
        Para k <- i Hasta j - 1 Hacer
            opIzq <- FuerzaBrutaCadena(p, i, k, s, ordIzq)
            opDer <- FuerzaBrutaCadena(p, k + 1, j, s, ordDer)
            opUnion <- p[i] * p[k + 1] * p[j + 1]
            opTotal <- opIzq + opDer + opUnion

            Si minOp = -1 Entonces
                minOp <- opTotal
                mejorK <- k
                mejorOrden <- "(" + ordIzq + " x " + ordDer + ")"
            SiNo
                Si opTotal < minOp Entonces
                    minOp <- opTotal
                    mejorK <- k
                    mejorOrden <- "(" + ordIzq + " x " + ordDer + ")"
                FinSi
            FinSi
        FinPara

        s[i, j] <- mejorK
    FinSi
FinSubProceso

SubProceso MultiplicarEnOrden(M Por Referencia, p Por Referencia, s Por Referencia, i, j, maxDim, R Por Referencia, filasR Por Referencia, colsR Por Referencia)
    Definir k, f, c, fIzq, cIzq, fDer, cDer Como Entero
    Definir izq, der Como Real
    Dimensionar izq[maxDim, maxDim]
    Dimensionar der[maxDim, maxDim]

    Si i = j Entonces
        filasR <- p[i]
        colsR <- p[i + 1]
        Para f <- 1 Hasta filasR Hacer
            Para c <- 1 Hasta colsR Hacer
                R[f, c] <- M[i, f, c]
            FinPara
        FinPara
    SiNo
        k <- s[i, j]
        fIzq <- 0
        cIzq <- 0
        fDer <- 0
        cDer <- 0
        MultiplicarEnOrden(M, p, s, i, k, maxDim, izq, fIzq, cIzq)
        MultiplicarEnOrden(M, p, s, k + 1, j, maxDim, der, fDer, cDer)
        MultiplicarMatrices(izq, fIzq, cIzq, der, cDer, R)
        filasR <- fIzq
        colsR <- cDer
    FinSi
FinSubProceso

SubProceso ok <- EsNumeroValido(tok)
    Definir i, inicio, longTok Como Entero
    Definir ch Como Texto
    Definir tieneDigito, tienePunto, ok Como Logico

    longTok <- Longitud(tok)
    Si longTok = 0 Entonces
        ok <- Falso
    SiNo
        inicio <- 1
        ch <- Subcadena(tok, 1, 1)
        Si ch = "-" O ch = "+" Entonces
            inicio <- 2
        FinSi

        Si inicio > longTok Entonces
            ok <- Falso
        SiNo
            tieneDigito <- Falso
            tienePunto <- Falso
            ok <- Verdadero
            Para i <- inicio Hasta longTok Hacer
                ch <- Subcadena(tok, i, i)
                Si ch >= "0" Y ch <= "9" Entonces
                    tieneDigito <- Verdadero
                SiNo
                    Si ch = "." Y NO tienePunto Entonces
                        tienePunto <- Verdadero
                    SiNo
                        ok <- Falso
                    FinSi
                FinSi
            FinPara
            ok <- ok Y tieneDigito
        FinSi
    FinSi
FinSubProceso

SubProceso LeerFila(matriz Por Referencia, idxM, filaActual, columnas)
    Definir cad, token Como Texto
    Definir longCad, pos, cont, i Como Entero
    Definir valido, esNumError Como Logico
    Definir valores Como Real
    Dimensionar valores[columnas]

    Repetir
        Escribir Sin Saltar "    Fila ", filaActual, ": "
        Leer cad
        cad <- cad + " "
        longCad <- Longitud(cad)
        token <- ""
        cont <- 0
        valido <- Verdadero
        esNumError <- Falso

        Para pos <- 1 Hasta longCad Hacer
            Si Subcadena(cad, pos, pos) <> " " Entonces
                token <- token + Subcadena(cad, pos, pos)
            SiNo
                Si Longitud(token) > 0 Entonces
                    Si EsNumeroValido(token) Entonces
                        cont <- cont + 1
                        Si cont <= columnas Entonces
                            valores[cont] <- ConvertirANumero(token)
                        SiNo
                            valido <- Falso
                        FinSi
                    SiNo
                        valido <- Falso
                        esNumError <- Verdadero
                    FinSi
                    token <- ""
                FinSi
            FinSi
        FinPara

        Si cont <> columnas Entonces
            valido <- Falso
        FinSi

        Si NO valido Entonces
            Si esNumError Entonces
                Escribir "    Valores inválidos, intenta de nuevo."
            SiNo
                Escribir "    Deben ser ", columnas, " números."
            FinSi
        FinSi
    Hasta Que valido

    Para i <- 1 Hasta columnas Hacer
        matriz[idxM, filaActual, i] <- valores[i]
    FinPara
FinSubProceso

SubProceso LeerMatriz(matrices Por Referencia, idxM, nombre, maxDim, filas Por Referencia, columnas Por Referencia)
    Definir numFila Como Entero

    Repetir
        Escribir Sin Saltar "  Filas de ", nombre, ": "
        Leer filas
        Escribir Sin Saltar "  Columnas de ", nombre, ": "
        Leer columnas
        Si filas <= 0 O columnas <= 0 Entonces
            Escribir "  Deben ser positivas."
        SiNo
            Si filas > maxDim O columnas > maxDim Entonces
                Escribir "  El máximo permitido es ", maxDim, "."
            FinSi
        FinSi
    Hasta Que filas > 0 Y columnas > 0 Y filas <= maxDim Y columnas <= maxDim

    Escribir "  Introduce las ", filas, " filas de ", nombre, " (números separados por espacios):"
    Para numFila <- 1 Hasta filas Hacer
        LeerFila(matrices, idxM, numFila, columnas)
    FinPara
FinSubProceso

// =========================================================
// PROCESO PRINCIPAL
// =========================================================

Proceso MultiplicacionMatricesFuerzaBruta
    Definir n, i, j, maxDim, minOperaciones, fRes, cRes, fTemp, cTemp Como Entero
    Definir validas Como Logico
    Definir mejorOrden Como Texto
    Definir filasMat, colsMat, p, s Como Entero
    Definir matrices, resultado Como Real

    maxDim <- 50   // Tamaño máximo por fila/columna

    Escribir "=== Multiplicación de matrices mediante fuerza bruta ==="

    Repetir
        Escribir Sin Saltar "¿Cuántas matrices desea multiplicar? "
        Leer n
        Si n < 2 Entonces
            Escribir "Deben ser al menos 2."
        FinSi
    Hasta Que n >= 2

    Dimensionar filasMat[n]
    Dimensionar colsMat[n]
    Dimensionar matrices[n, maxDim, maxDim]

    Para i <- 1 Hasta n Hacer
        Escribir ""
        Escribir "Matriz A", i, ":"
        fTemp <- 0
        cTemp <- 0
        LeerMatriz(matrices, i, "A" + ConvertirATexto(i), maxDim, fTemp, cTemp)
        filasMat[i] <- fTemp
        colsMat[i] <- cTemp
    FinPara

    // Verificar compatibilidad y detenerse en el primer error
    validas <- Verdadero
    Para i <- 1 Hasta n - 1 Hacer
        Si validas Entonces
            Si colsMat[i] <> filasMat[i + 1] Entonces
                Escribir ""
                Escribir "Error: A", i, " tiene ", colsMat[i], " columnas pero A", i + 1, " tiene ", filasMat[i + 1], " filas."
                validas <- Falso
            FinSi
        FinSi
    FinPara

    Si validas Entonces
        Dimensionar p[n + 1]
        p[1] <- filasMat[1]
        Para i <- 1 Hasta n Hacer
            p[i + 1] <- colsMat[i]
        FinPara

        Dimensionar s[n, n]
        mejorOrden <- ""
        minOperaciones <- FuerzaBrutaCadena(p, 1, n, s, mejorOrden)

        Escribir ""
        Escribir "Mínimo de operaciones: ", minOperaciones
        Escribir "Mejor orden: ", mejorOrden

        Dimensionar resultado[maxDim, maxDim]
        fRes <- 0
        cRes <- 0
        MultiplicarEnOrden(matrices, p, s, 1, n, maxDim, resultado, fRes, cRes)

        Escribir ""
        Escribir "Resultado:"
        Para i <- 1 Hasta fRes Hacer
            Escribir Sin Saltar "   ["
            Para j <- 1 Hasta cRes Hacer
                Escribir Sin Saltar resultado[i, j]
                Si j < cRes Entonces
                    Escribir Sin Saltar ", "
                FinSi
            FinPara
            Escribir "]"
        FinPara
    FinSi
FinProceso
