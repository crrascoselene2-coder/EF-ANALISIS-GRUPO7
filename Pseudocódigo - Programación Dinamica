// Calcula las tablas DP: m[i,j] (costo minimo) y s[i,j] (corte optimo k)
SubProceso OrdenCadenaMatrices(dims, n, m, s, iteracionesK Por Referencia)
	Definir longitud, i, j, k Como Entero;
	Definir costo Como Real;

	iteracionesK <- 0;

	// Caso base: costo 0 cuando solo hay una matriz (subcadena de longitud 1)
	Para i <- 1 Hasta n Con Paso 1 Hacer
		m[i, i] <- 0;
		s[i, i] <- 0;
	FinPara

	// Llenar las tablas por longitud creciente de subcadena (L = 2 hasta n)
	Para longitud <- 2 Hasta n Con Paso 1 Hacer
		Para i <- 1 Hasta n - longitud + 1 Con Paso 1 Hacer
			j <- i + longitud - 1;
			m[i, j] <- -1;

			Para k <- i Hasta j - 1 Con Paso 1 Hacer
				iteracionesK <- iteracionesK + 1;
				costo <- m[i, k] + m[k + 1, j] + dims[i] * dims[k + 1] * dims[j + 1];

				Si m[i, j] = -1 O costo < m[i, j] Entonces
					m[i, j] <- costo;
					s[i, j] <- k;
				FinSi
			FinPara
		FinPara
	FinPara
FinSubProceso

// Multiplica los bloques bufIzq[nivel] (filasA x colsA) y bufDer[nivel] (colsA x colsB)
// almacenando el resultado en bufRes[nivel]
SubProceso MultiplicarMatricesNivel(bufIzq, filasA, colsA, bufDer, colsB, bufRes, nivel)
	Definir i, k, j Como Entero;
	Definir valorA Como Real;

	Para i <- 1 Hasta filasA Con Paso 1 Hacer
		Para j <- 1 Hasta colsB Con Paso 1 Hacer
			bufRes[nivel, i, j] <- 0;
		FinPara
	FinPara

	Para i <- 1 Hasta filasA Con Paso 1 Hacer
		Para k <- 1 Hasta colsA Con Paso 1 Hacer
			valorA <- bufIzq[nivel, i, k];
			Si valorA <> 0 Entonces
				Para j <- 1 Hasta colsB Con Paso 1 Hacer
					bufRes[nivel, i, j] <- bufRes[nivel, i, j] + valorA * bufDer[nivel, k, j];
				FinPara
			FinSi
		FinPara
	FinPara
FinSubProceso

// Multiplica las matrices reales siguiendo los cortes guardados en la tabla s[i,j]
SubProceso MultiplicarPorOrden(mats, filasM, colsM, s, i, j, nivel, bufIzq, bufDer, bufRes, resF Por Referencia, resC Por Referencia)
	Definir f, c, k, fIzq, cIzq, fDer, cDer Como Entero;

	Si i = j Entonces
		resF <- filasM[i];
		resC <- colsM[i];
		Para f <- 1 Hasta resF Con Paso 1 Hacer
			Para c <- 1 Hasta resC Con Paso 1 Hacer
				bufRes[nivel, f, c] <- mats[i, f, c];
			FinPara
		FinPara
	SiNo
		k <- s[i, j];

		// Resolver subcadena izquierda (i..k) en nivel + 1
		MultiplicarPorOrden(mats, filasM, colsM, s, i, k, nivel + 1, bufIzq, bufDer, bufRes, fIzq, cIzq);
		Para f <- 1 Hasta fIzq Con Paso 1 Hacer
			Para c <- 1 Hasta cIzq Con Paso 1 Hacer
				bufIzq[nivel, f, c] <- bufRes[nivel + 1, f, c];
			FinPara
		FinPara

		// Resolver subcadena derecha (k+1..j) en nivel + 1
		MultiplicarPorOrden(mats, filasM, colsM, s, k + 1, j, nivel + 1, bufIzq, bufDer, bufRes, fDer, cDer);
		Para f <- 1 Hasta fDer Con Paso 1 Hacer
			Para c <- 1 Hasta cDer Con Paso 1 Hacer
				bufDer[nivel, f, c] <- bufRes[nivel + 1, f, c];
			FinPara
		FinPara

		// Multiplicar resultados parciales en el nivel actual
		MultiplicarMatricesNivel(bufIzq, fIzq, cIzq, bufDer, cDer, bufRes, nivel);
		resF <- fIzq;
		resC <- cDer;
	FinSi
FinSubProceso

// Reconstruye la expresion parentizada optima usando la tabla s
Funcion textoOrden <- ObtenerMejorOrden(s, i, j)
	Definir k Como Entero;
	Definir izqTxt, derTxt, tempTxt, textoOrden Como Cadena;

	Si i = j Entonces
		textoOrden <- Concatenar("A", ConvertirATexto(i));
	SiNo
		k <- s[i, j];
		izqTxt <- ObtenerMejorOrden(s, i, k);
		derTxt <- ObtenerMejorOrden(s, k + 1, j);
		tempTxt <- Concatenar("(", izqTxt);
		tempTxt <- Concatenar(tempTxt, " x ");
		tempTxt <- Concatenar(tempTxt, derTxt);
		textoOrden <- Concatenar(tempTxt, ")");
	FinSi
FinFuncion

Proceso MultiplicacionMatricesPD
	Definir n, idx, f, c, resF, resC, iteracionesK Como Entero;
	Definir mejorOrden Como Cadena;
	Definir compatible Como Logico;

	Dimension mats[20, 20, 20];
	Dimension filasM[20];
	Dimension colsM[20];
	Dimension dims[21];
	Dimension m[21, 21];
	Dimension s[21, 21];
	Dimension bufIzq[25, 20, 20];
	Dimension bufDer[25, 20, 20];
	Dimension bufRes[25, 20, 20];

	Escribir "=== Multiplicacion de matrices mediante PROGRAMACION DINAMICA ===";
	Repetir
		Escribir "Cuantas matrices desea multiplicar? (2 a 20): ";
		Leer n;
		Si n < 2 O n > 20 Entonces
			Escribir "Debe ingresar un numero entre 2 y 20.";
		FinSi
	Hasta Que n >= 2 Y n <= 20;

	// Lectura de dimensiones y elementos de cada matriz
	Para idx <- 1 Hasta n Con Paso 1 Hacer
		Escribir "";
		Escribir "Matriz A", idx, ":";
		Repetir
			Escribir "  Filas de A", idx, " (1 a 20): ";
			Leer filasM[idx];
			Escribir "  Columnas de A", idx, " (1 a 20): ";
			Leer colsM[idx];
			Si filasM[idx] <= 0 O colsM[idx] <= 0 O filasM[idx] > 20 O colsM[idx] > 20 Entonces
				Escribir "  Dimensiones invalidas (deben estar entre 1 y 20).";
			FinSi
		Hasta Que filasM[idx] > 0 Y colsM[idx] > 0 Y filasM[idx] <= 20 Y colsM[idx] <= 20;

		Escribir "  Ingrese los elementos de A", idx, ":";
		Para f <- 1 Hasta filasM[idx] Con Paso 1 Hacer
			Para c <- 1 Hasta colsM[idx] Con Paso 1 Hacer
				Escribir Sin Saltar "    A", idx, "[", f, ",", c, "]: ";
				Leer mats[idx, f, c];
			FinPara
		FinPara
	FinPara

	// Verificacion de compatibilidad dimensional
	compatible <- Verdadero;
	Para idx <- 1 Hasta n - 1 Con Paso 1 Hacer
		Si colsM[idx] <> filasM[idx + 1] Entonces
			Escribir "";
			Escribir "Error: A", idx, " tiene ", colsM[idx], " columnas pero A", idx + 1, " tiene ", filasM[idx + 1], " filas.";
			compatible <- Falso;
		FinSi
	FinPara

	Si compatible Entonces
		// Vector de dimensiones: dims[1] = filas(A1), dims[idx+1] = columnas(A_idx)
		dims[1] <- filasM[1];
		Para idx <- 1 Hasta n Con Paso 1 Hacer
			dims[idx + 1] <- colsM[idx];
		FinPara

		OrdenCadenaMatrices(dims, n, m, s, iteracionesK);
		mejorOrden <- ObtenerMejorOrden(s, 1, n);

		Escribir "";
		Escribir "Minimo de multiplicaciones escalares: ", m[1, n];
		Escribir "Mejor orden de parentizacion: ", mejorOrden;
		Escribir "Iteraciones de busqueda de corte k (PD): ", iteracionesK;

		MultiplicarPorOrden(mats, filasM, colsM, s, 1, n, 1, bufIzq, bufDer, bufRes, resF, resC);

		Escribir "";
		Escribir "Matriz Resultado (", resF, " x ", resC, "):";
		Para f <- 1 Hasta resF Con Paso 1 Hacer
			Para c <- 1 Hasta resC Con Paso 1 Hacer
				Escribir Sin Saltar bufRes[1, f, c], "  ";
			FinPara
			Escribir "";
		FinPara
	FinSi
FinProceso
