"""Multiplicación en Cadena de Matrices — Versión Fuerza Bruta.

Curso: Análisis de Algoritmos y Estrategias de Programación (2026-2)
"""

import time


def multiplicar_matrices(matriz_a, matriz_b):
    """Multiplica dos matrices omitiendo productos por cero en matriz_a."""
    filas_a, cols_a = len(matriz_a), len(matriz_a[0])
    cols_b = len(matriz_b[0])
    resultado = [[0] * cols_b for _ in range(filas_a)]
    for i in range(filas_a):
        for k in range(cols_a):
            valor_a = matriz_a[i][k]
            if valor_a == 0:
                continue
            for j in range(cols_b):
                resultado[i][j] += valor_a * matriz_b[k][j]
    return resultado


def fuerza_bruta_cadena(dimensiones, i, j, contador=None):
    """Encuentra el mínimo costo de multiplicación explorando todas las divisiones."""
    if contador is not None:
        contador["llamadas"] += 1

    if i == j:
        return 0, f"A{i}", i

    min_operaciones = float("inf")
    mejor_orden = ""
    mejor_arbol = None

    for k in range(i, j):
        if contador is not None:
            contador["iteraciones_k"] += 1

        operaciones_izq, orden_izq, arbol_izq = fuerza_bruta_cadena(
            dimensiones, i, k, contador
        )
        operaciones_der, orden_der, arbol_der = fuerza_bruta_cadena(
            dimensiones, k + 1, j, contador
        )
        operaciones_union = dimensiones[i - 1] * dimensiones[k] * dimensiones[j]
        operaciones_total = operaciones_izq + operaciones_der + operaciones_union

        if operaciones_total < min_operaciones:
            min_operaciones = operaciones_total
            mejor_orden = f"({orden_izq} x {orden_der})"
            mejor_arbol = (arbol_izq, arbol_der)

    return min_operaciones, mejor_orden, mejor_arbol


def multiplicar_en_orden(matrices, arbol):
    """Multiplica las matrices reales siguiendo el árbol de parentización óptimo."""
    if isinstance(arbol, int):
        return matrices[arbol - 1]
    arbol_izq, arbol_der = arbol
    izq = multiplicar_en_orden(matrices, arbol_izq)
    der = multiplicar_en_orden(matrices, arbol_der)
    return multiplicar_matrices(izq, der)


def leer_matriz(nombre):
    """Solicita dimensiones y filas de una matriz validando la entrada."""
    while True:
        try:
            filas = int(input(f"  Filas de {nombre}: "))
            columnas = int(input(f"  Columnas de {nombre}: "))
            if filas <= 0 or columnas <= 0:
                print("  Deben ser positivas.")
                continue
            break
        except ValueError:
            print("  Introduce números enteros.")

    print(f"  Introduce las {filas} filas de {nombre} (números separados por espacios):")
    matriz = []
    for num_fila in range(filas):
        while True:
            try:
                fila = list(map(float, input(f"    Fila {num_fila + 1}: ").split()))
                if len(fila) != columnas:
                    print(f"    Deben ser {columnas} números.")
                    continue
                matriz.append(fila)
                break
            except ValueError:
                print("    Valores inválidos, intenta de nuevo.")
    return matriz


def principal():
    """Punto de entrada interactivo para multiplicar una cadena de matrices."""
    print("=== Multiplicación de matrices mediante fuerza bruta ===")
    while True:
        try:
            n = int(input("¿Cuántas matrices desea multiplicar? "))
            if n >= 2:
                break
            print("Deben ser al menos 2.")
        except ValueError:
            print("Introduce un entero.")

    matrices = []
    for indice in range(1, n + 1):
        print(f"\nMatriz A{indice}:")
        matrices.append(leer_matriz(f"A{indice}"))

    for indice in range(n - 1):
        if len(matrices[indice][0]) != len(matrices[indice + 1]):
            print(
                f"\nError: A{indice + 1} tiene {len(matrices[indice][0])} columnas "
                f"pero A{indice + 2} tiene {len(matrices[indice + 1])} filas."
            )
            return

    dimensiones = [len(matrices[0])] + [len(matriz[0]) for matriz in matrices]
    contador = {"llamadas": 0, "iteraciones_k": 0}

    inicio = time.perf_counter()
    min_operaciones, mejor_orden, mejor_arbol = fuerza_bruta_cadena(
        dimensiones, 1, n, contador
    )
    tiempo_ms = (time.perf_counter() - inicio) * 1000

    print("\nMínimo de operaciones:", int(min_operaciones))
    print("Mejor orden:", mejor_orden)
    print(f"Llamadas recursivas: {contador['llamadas']:,}")
    print(f"Evaluaciones de corte k: {contador['iteraciones_k']:,}")
    print(f"Tiempo de búsqueda: {tiempo_ms:.4f} ms")

    resultado = multiplicar_en_orden(matrices, mejor_arbol)

    print("\nResultado:")
    for fila in resultado:
        print("  ", fila)


if __name__ == "__main__":
    principal()
